# Python caches and local environments
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
.worktrees/

# Runtime and experiment artifacts
checkpoints/
# Keep the frozen coverage-v3, stability-aware-v4 and slew-limit-v5 deliveries
# in Git; other runs remain regenerable.
results/*
!results/pure_reward_teacher_bank_coverage_v3/
!results/pure_reward_teacher_bank_coverage_v3/**
!results/pure_reward_teacher_bank_coverage_v4/
!results/pure_reward_teacher_bank_coverage_v4/**
!results/pure_reward_teacher_bank_coverage_v5/
!results/pure_reward_teacher_bank_coverage_v5/**
img/
tmp/
# Stray Manim cache written at the repo root; the demo keeps its own media/.
/media/

# Derived distribution copies of the curated figure pack in pic/.
pic.zip
pic/README.html
pic/style.css

# Legacy TCN checkpoints are 160 MB each and exceed GitHub's normal blob limit.
basic/results_tcn/*.pt

# Freeze the two plant libraries used by the reported experiments.
data/aircraft/generated/*
!data/aircraft/generated/p_channel_library_20260827_v2_stratified/
!data/aircraft/generated/p_channel_library_20260827_v2_stratified/**
!data/aircraft/generated/p_channel_library_iv_a_manual_v1/
!data/aircraft/generated/p_channel_library_iv_a_manual_v1/**

# Notebook and editor state
.ipynb_checkpoints/
.vscode/
.idea/
