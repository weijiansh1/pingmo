  "equations": [
    "G_\\theta(s)=L_{F_a}\\,\\frac{s(s^2+2\\zeta_\\phi\\omega_\\phi s+\\omega_\\phi^2)}{(s-\\lambda_s)(s+1/T_R)(s^2+2\\zeta_d\\omega_ds+\\omega_d^2)}\\,e^{-\\tau_ps}.",
    "\\begin{gathered}o_t=\\operatorname{Norm}\\!\\bigl([p_{\\mathrm{cmd}},p_{\\mathrm{ref}},p,e,\\int e\\,dt,\\dot p,\\dot p_{\\mathrm{ref}},F_{\\mathrm{req}},F_{\\mathrm{applied}},h_{t-31:t},a_{t-7:t-1}]\\bigr)\\in\\mathbb R^{176},\\\\[0.4em]o_t^{\\mathrm T}=[o_t,z_t]\\in\\mathbb R^{188},\\qquad o_t^{\\mathrm S}=o_t.\\end{gathered}",
    "\\begin{aligned}\\operatorname{RMSE}_p&=\\sqrt{\\frac1M\\sum_{t=1}^M(p_{\\mathrm{ref},t}-p_t)^2},\\\\\\operatorname{Peak}&=\\max_t|p_{\\mathrm{ref},t}-p_t|,\\\\\\operatorname{TV}_F&=\\frac1T\\sum_{t=1}^M|F_{\\mathrm{req},t}-F_{\\mathrm{req},t-1}|.\\end{aligned}",
    "R_{\\mathrm D}=\\operatorname*{median}_{i\\in I}\\left(\\frac{\\operatorname{RMSE}_{p,i}^{\\mathrm S}}{\\operatorname{RMSE}_{p,i}^{\\mathrm T}}\\right).",
    "\\theta^{(i)}\\sim q(\\theta\\mid c_i),\\qquad g_i=\\operatorname{Grade}_{\\mathrm{src}}(\\theta^{(i)},c_i).",
    "\\begin{gathered}F_{\\mathrm{req},t+1}=\\operatorname{clip}\\!\\left(F_{\\mathrm{req},t}+(88\\,\\mathrm{N/s})a_t\\Delta t,-22\\,\\mathrm N,22\\,\\mathrm N\\right),\\\\\\Delta t=0.02\\,\\mathrm s.\\end{gathered}",
    "r_t=-50\\left[\\left(\\frac{e_t}{p_{\\mathrm{scale}}}\\right)^2\\Delta t+0.02\\left(\\frac{F_{\\mathrm{applied},t}}{22\\,\\mathrm N}\\right)^2\\Delta t+0.02a_t^2\\right].",
    "\\begin{aligned}\\delta_t&=r_t+\\gamma V_{v_{\\mathrm{old}}}(s_{t+1})-V_{v_{\\mathrm{old}}}(s_t),\\\\\\widehat A_t&=\\delta_t+\\gamma\\lambda\\widehat A_{t+1},\\qquad\\gamma=0.995,\\quad\\lambda=0.95.\\end{aligned}",
    "\\begin{gathered}\\mathcal L_{\\mathrm{clip}}(w)=-\\mathbb E_t\\!\\left[\\min\\!\\left(\\rho_t\\widehat A_t,\\operatorname{clip}(\\rho_t,1-\\epsilon,1+\\epsilon)\\widehat A_t\\right)\\right],\\\\\\epsilon=0.2.\\end{gathered}",
    "\\begin{aligned}\\mathcal L_{\\mathrm{total}}&=\\mathcal L_{\\mathrm{clip}}+0.5\\,\\mathbb E[(V_v(s_t)-\\widehat R_t)^2]-0.001\\,\\mathcal H(\\pi_w),\\\\\\widehat R_t&=\\widehat A_t+V_{v_{\\mathrm{old}}}(s_t).\\end{aligned}",
    "\\begin{aligned}D_0&=\\{(o_t,\\mu_{\\mathrm T}(o_t,z_t))\\},\\\\D_{k+1}&=D_k\\cup\\{(o_t^{\\mathrm S,k},\\mu_{\\mathrm T}(o_t^{\\mathrm S,k},z_t))\\}.\\end{aligned}",
    "w_{\\mathrm S}^{*}=\\operatorname*{arg\\,min}_w\\frac1{|D_K|}\\sum_{(o,u_{\\mathrm T})\\in D_K}\\|\\mu_{\\mathrm S}(o;w)-u_{\\mathrm T}\\|^2.",
    "\\begin{aligned}e_t(W)&=p_{\\mathrm{ref},t}-p_t(W;\\widehat G_{\\mathrm{ARX}}),\\\\\\mathcal L_{\\mathrm{DHC6}}(W)&=\\frac1{N_{t\\ge2\\,\\mathrm s}}\\sum_{t\\ge2\\,\\mathrm s}e_t(W)^2,\\\\W_{k+1}&=\\operatorname{AdamUpdate}(W_k,\\nabla_W\\mathcal L_{\\mathrm{DHC6}};\\eta=3\\times10^{-5}).\\end{aligned}"
  ]
}
